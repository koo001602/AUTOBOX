# AutoBox Backend Docker Environment Variables
# Usage: cp .env.example .env && nano .env
#
# 실행: cd backend && docker-compose up -d --build

# ===========================================
# Database Configuration
# ===========================================
# 외부 DB 사용 시 (Azure MySQL, AWS RDS 등)
DATABASE_URL=mysql+pymysql://S14P11A403:1UB5b1SMZQ@ssafy-mysql-db.mysql.database.azure.com:3306/S14P11A403?charset=utf8mb4

# 로컬 MySQL 사용 시 (--profile with-db)
# DATABASE_URL=mysql+pymysql://root:root@mysql:3306/autobox
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=autobox

# ===========================================
# Backend Configuration
# ===========================================
BACKEND_PORT=8000
DEBUG=false
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173

# ===========================================
# Frontend Configuration
# ===========================================
FRONTEND_PORT=80
VITE_API_URL=http://localhost:8000/api/v1

# ===========================================
# MQTT Configuration (Mosquitto Broker)
# ===========================================
# Docker 내부 통신 (자동 설정됨)
# MQTT_BROKER_HOST=mosquitto
# MQTT_BROKER_PORT=1883

MQTT_TOPIC_PREFIX=autobox
MQTT_CLIENT_ID=autobox-backend
MQTT_USERNAME=backend
MQTT_PASSWORD=your_mqtt_password_here
MQTT_ENABLED=true

# ===========================================
# MQTT TLS Configuration (외부 연결용)
# ===========================================
MQTT_USE_TLS=false
MQTT_CA_CERT=
MQTT_CLIENT_CERT=
MQTT_CLIENT_KEY=
MQTT_TLS_INSECURE=false

# ===========================================
# Raspberry Pi REST API (optional)
# ===========================================
RASPBERRY_PI_URL=http://192.168.0.100:5000
