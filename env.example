# AutoBox Docker Environment Variables
# Copy this file to .env and modify as needed

# MySQL Configuration
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=autobox
MYSQL_PORT=3306

# Backend Configuration
BACKEND_PORT=8000
DEBUG=false
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173

# Frontend Configuration
FRONTEND_PORT=80
VITE_API_URL=http://localhost:8000/api/v1

# For EC2 deployment, update these values:
# CORS_ORIGINS=http://YOUR_EC2_IP,http://YOUR_DOMAIN
# VITE_API_URL=http://YOUR_EC2_IP:8000/api/v1
