# AutoBox Docker Environment Variables
# 템플릿 파일 - 실제 값은 .env.local 또는 .env.production 참조
#
# 사용법:
#   로컬 개발: cp .env.local .env
#   EC2 배포:  cp .env.production .env

# Database URL (Azure MySQL)
DATABASE_URL=mysql+pymysql://<USER>:<PASSWORD>@<HOST>:3306/<DATABASE>?charset=utf8mb4

# Backend Configuration
BACKEND_PORT=8000
DEBUG=false
CORS_ORIGINS=http://localhost,http://<YOUR_SERVER_IP>

# Frontend Configuration
FRONTEND_PORT=80
VITE_API_URL=http://<YOUR_SERVER_IP>:8000/api/v1

# MQTT Configuration (EC2 Mosquitto Broker)
# Backend connects to local Mosquitto container via Docker network
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX=autobox
MQTT_CLIENT_ID=autobox-backend
MQTT_USERNAME=backend
MQTT_PASSWORD=<MQTT_PASSWORD>
MQTT_ENABLED=true

# MQTT TLS Configuration (for external connections)
MQTT_USE_TLS=false
MQTT_CA_CERT=
MQTT_CLIENT_CERT=
MQTT_CLIENT_KEY=
MQTT_TLS_INSECURE=false

# Raspberry Pi REST API (optional)
RASPBERRY_PI_URL=http://<RASPBERRY_PI_IP>:5000
